# ==============================================================================
# BBPulse Telugu - Production Environment Variables Template
# Set these variables in Vercel Project Settings > Environment Variables
# ==============================================================================

# 1. Neon PostgreSQL Database Connection
# Format: postgresql://neondb_owner:<YOUR_PASSWORD>@<YOUR_NEON_HOST>/neondb?sslmode=require
DATABASE_URL="postgresql://neondb_owner:YOUR_PASSWORD@ep-cool-wind-b4cj02bw-pooler.c-6.us-east-2.aws.neon.tech/neondb?sslmode=require"

# 2. Google OAuth 2.0 Credentials (From Google Cloud Console: https://console.cloud.google.com/apis/credentials)
# Create OAuth 2.0 Client ID (Web Application)
GOOGLE_CLIENT_ID="YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="GOCSPX-YOUR_GOOGLE_CLIENT_SECRET"

# 3. Application Public URL (Production Vercel domain or localhost)
# For local development: http://localhost:3000
# For Vercel production: https://your-project.vercel.app (or custom domain)
NEXT_PUBLIC_APP_URL="https://your-project.vercel.app"

# 4. Session Token Signing Secret (32+ random characters)
# Generate via: openssl rand -base64 32
SESSION_SECRET="generate-a-secure-random-32-char-secret-key-here"
